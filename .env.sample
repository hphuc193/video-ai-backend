# Chuỗi kết nối Database PostgreSQL (Sử dụng URL local hoặc Cloud)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/video_ai_db?schema=public"

# Google Sign-In Client ID (Lấy từ Google Cloud Console)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"

# Secret Key để mã hóa JWT (Tự tạo chuỗi ngẫu nhiên bảo mật)
JWT_SECRET="your_jwt_secret_key"